<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon (NotifyIcon). Everything else is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CouchDeck</RootNamespace>
    <AssemblyName>CouchDeck</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from UI/AppIcon.cs (run CouchDeck.exe with the export-icon switch, see AppIcon.cs) -->
    <ApplicationIcon>Assets\CouchDeck.ico</ApplicationIcon>
    <Product>CouchDeck</Product>
    <Description>Controller-first game launcher overlay for Windows</Description>
    <Version>2.0.0</Version>
    <!-- Lets the project build on non-Windows machines (CI, Linux). Harmless on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Low-latency mixing for the UI sound effects -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
