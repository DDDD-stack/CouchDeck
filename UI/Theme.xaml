<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:CouchDeck.UI">

    <!--
        Designed for a TV ~3 m away: big type, high contrast, one obvious focus treatment.
        Colours, sizes and fonts are set at runtime by ThemeManager (Customize page) and used here
        as DynamicResource. The values below are only the defaults before ThemeManager runs.

        Performance rules followed in these templates (WPF re-renders whatever overlaps a moving
        element every frame, so these matter on a TV-sized screen):
          - no clipping to rounded corners: art is painted with an ImageBrush inside a rounded Border
          - no Opacity on panels at rest (that renders the panel into its own layer every frame);
            dimming is a black overlay instead
          - every blur/shadow effect sits inside a BitmapCache, so it's computed once, not per frame
    -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#07080D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#B0161A24" />
    <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#141821" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="#D0262C3A" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#B0E6EAF2" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#70E6EAF2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#00D4FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#387C5CFF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="White" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5A6A" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#B807080D" />
    <SolidColorBrush x:Key="TilePlaceholderBrush" Color="#262C3A" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C5CFF" Offset="0" />
        <GradientStop Color="#00D4FF" Offset="1" />
    </LinearGradientBrush>
    <Color x:Key="AccentGlowColor">#7C5CFF</Color>
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontWeight x:Key="TitleWeight">Bold</FontWeight>
    <CornerRadius x:Key="TileRadius">16</CornerRadius>
    <CornerRadius x:Key="TileBottomRadius">0,0,16,16</CornerRadius>
    <CornerRadius x:Key="TileGlowRadius">22</CornerRadius>
    <CornerRadius x:Key="PanelRadius">24</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">16</CornerRadius>
    <CornerRadius x:Key="PillRadius">32</CornerRadius>
    <Visibility x:Key="BadgeVisibility">Visible</Visibility>

    <!-- Bottom fade under tile captions -->
    <LinearGradientBrush x:Key="CaptionFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#99000000" Offset="0.45" />
        <GradientStop Color="#EE000000" Offset="1" />
    </LinearGradientBrush>

    <!-- ===================================================================== Text -->

    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="Margin" Value="10,26,0,10" />
    </Style>

    <Style x:Key="TabText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="26,10,26,11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>

    <!-- ===================================================================== Panels -->

    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PanelRadius}" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontSize" Value="16" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===================================================================== Game tile -->

    <!-- Download bar on a tile. Bind Value (0..1) OneWay: ProgressBar.Value binds two-way by default. -->
    <Style x:Key="TileProgress" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="4" Background="#40FFFFFF" />
                        <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left" Background="{DynamicResource AccentGradientBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Portrait cover. Focus animation (zoom, lift, glow, light sweep, caption, dim) runs in code
        (Fx.Mode="Tile") so the amounts follow the Customize page. Binds to GameTileViewModel.
    -->
    <Style x:Key="GameTile" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource TileWidth}" />
        <Setter Property="Height" Value="{DynamicResource TileHeight}" />
        <Setter Property="Margin" Value="{DynamicResource TileMargin}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ui:Fx.Mode" Value="Tile" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Coloured glow behind the card. Cached: the blur is computed once per focus, not per frame. -->
                        <Grid x:Name="PART_Glow" Margin="-3" Opacity="0" Visibility="Hidden">
                            <Grid.CacheMode>
                                <BitmapCache />
                            </Grid.CacheMode>
                            <Border CornerRadius="{DynamicResource TileGlowRadius}" Background="{DynamicResource AccentGradientBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <!-- No art (yet): exe icon + title on a soft gradient -->
                        <Border CornerRadius="{DynamicResource TileRadius}" Background="{DynamicResource TilePlaceholderBrush}">
                            <StackPanel x:Name="Placeholder" VerticalAlignment="Center" Margin="18">
                                <Image x:Name="PlaceholderIcon" Source="{Binding Icon}" Width="88" Height="88" Margin="0,0,0,16"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="{DynamicResource TitleWeight}"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Landscape art: a dimmed copy fills the card behind the letterboxed original -->
                        <Border x:Name="LandscapeFill" CornerRadius="{DynamicResource TileRadius}" Visibility="Collapsed"
                                ui:Fx.ArtSource="{Binding Cover}" ui:Fx.ArtFill="True" />
                        <Border x:Name="LandscapeShade" CornerRadius="{DynamicResource TileRadius}" Visibility="Collapsed" Background="#99000000" />

                        <!-- The cover, painted inside the rounded border: rounded without a clip layer -->
                        <Border x:Name="Art" CornerRadius="{DynamicResource TileRadius}" ui:Fx.ArtSource="{Binding Cover}"
                                RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Steam is downloading or updating it: percentage and bar over the art (the caption still slides over it) -->
                        <Border x:Name="DownloadPanel" CornerRadius="{DynamicResource TileRadius}" Background="#B3000000"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel VerticalAlignment="Center" Margin="22,0">
                                <TextBlock x:Name="DownloadTitle" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxHeight="72" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"
                                           Visibility="Collapsed" />
                                <TextBlock Text="{Binding DownloadGlyph}" Style="{StaticResource IconText}" FontSize="24"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource Accent2Brush}" />
                                <TextBlock Text="{Binding DownloadPercent}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                <ProgressBar Style="{StaticResource TileProgress}" Value="{Binding DownloadFraction, Mode=OneWay}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding DownloadLabel}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Margin="0,8,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Title, slides up on focus (or always / never) -->
                        <Grid x:Name="PART_Caption" VerticalAlignment="Bottom" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                            <Border x:Name="CaptionBody" CornerRadius="{DynamicResource TileBottomRadius}" Background="{StaticResource CaptionFadeBrush}">
                                <TextBlock Text="{Binding Title}" Margin="14,46,14,14" FontSize="18" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="10,3,10,4"
                                Background="#A6000000" CornerRadius="11" Visibility="{DynamicResource BadgeVisibility}">
                            <TextBlock Text="{Binding SourceLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#E6FFFFFF" />
                        </Border>

                        <Border x:Name="FavoriteBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentGradientBrush}"
                                Visibility="Collapsed">
                            <TextBlock Text="&#xE735;" Style="{StaticResource IconText}" FontSize="15"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" />
                        </Border>

                        <!-- Dims unfocused tiles: a black overlay is far cheaper than Opacity on the whole card -->
                        <Border x:Name="PART_Dim" CornerRadius="{DynamicResource TileRadius}" Background="Black" Opacity="0" IsHitTestVisible="False" />

                        <!-- Light sweep: its gradient brush slides across (created and animated by Fx) -->
                        <Border x:Name="PART_Shine" CornerRadius="{DynamicResource TileRadius}" Visibility="Hidden" IsHitTestVisible="False" />

                        <!-- Hairline for definition on dark art; bright ring when focused -->
                        <Border CornerRadius="{DynamicResource TileRadius}" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1" IsHitTestVisible="False" />
                        <Border x:Name="Ring" CornerRadius="{DynamicResource TileRadius}" BorderThickness="3"
                                BorderBrush="Transparent" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasCover}" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasCover}" Value="False">
                            <Setter TargetName="CaptionBody" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                            <Setter TargetName="PlaceholderIcon" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLandscape}" Value="True">
                            <Setter TargetName="LandscapeFill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LandscapeShade" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                            <Setter TargetName="FavoriteBadge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                            <Setter TargetName="DownloadPanel" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- No art yet: the name moves into the download panel instead of sitting under it -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsDownloading}" Value="True" />
                                <Condition Binding="{Binding HasCover}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DownloadTitle" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#F2FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The "+ Add a game" tile at the end of the library -->
    <Style x:Key="AddTile" TargetType="Button" BasedOn="{StaticResource GameTile}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid x:Name="PART_Glow" Margin="-3" Opacity="0" Visibility="Hidden">
                            <Grid.CacheMode>
                                <BitmapCache />
                            </Grid.CacheMode>
                            <Border CornerRadius="{DynamicResource TileGlowRadius}" Background="{DynamicResource AccentGradientBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <Border CornerRadius="{DynamicResource TileRadius}" Background="{DynamicResource SurfaceBrush}">
                            <Grid>
                                <Rectangle RadiusX="{DynamicResource TileRadiusValue}" RadiusY="{DynamicResource TileRadiusValue}"
                                           Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="2" StrokeDashArray="4 3" Margin="10" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentGradientBrush}" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="30"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" Margin="0,18,0,4" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="{DynamicResource SubtleTextBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="22,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="PART_Dim" CornerRadius="{DynamicResource TileRadius}" Background="Black" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="Ring" CornerRadius="{DynamicResource TileRadius}" BorderThickness="3" BorderBrush="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#F2FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Buttons -->

    <!-- Big square-ish card with an icon (System page). BorderBrush = icon colour. -->
    <Style x:Key="ActionCard" TargetType="Button">
        <Setter Property="Width" Value="232" />
        <Setter Property="Height" Value="124" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ui:Fx.Mode" Value="Pop" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid x:Name="PART_Glow" Margin="-2" Opacity="0" Visibility="Hidden">
                            <Grid.CacheMode>
                                <BitmapCache />
                            </Grid.CacheMode>
                            <Border CornerRadius="{DynamicResource ButtonRadius}" Background="{DynamicResource AccentGradientBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="30" ShadowDepth="0" Opacity="0.8" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <Border x:Name="Frame" CornerRadius="{DynamicResource ButtonRadius}" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="22,18">
                            <Grid>
                                <TextBlock x:Name="Glyph" Text="{Binding (ui:Fx.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           Style="{StaticResource IconText}" FontSize="30" VerticalAlignment="Top" HorizontalAlignment="Left"
                                           Foreground="{TemplateBinding BorderBrush}" />
                                <ContentPresenter VerticalAlignment="Bottom" HorizontalAlignment="Left" TextElement.FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <Border x:Name="Ring" CornerRadius="{DynamicResource ButtonRadius}" BorderThickness="2.5" BorderBrush="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceHighBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#F2FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerCard" TargetType="Button" BasedOn="{StaticResource ActionCard}">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Rounded pill with icon + label (Now playing bar). -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Height" Value="62" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Padding" Value="26,0,30,0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ui:Fx.Mode" Value="Pop" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid x:Name="PART_Glow" Opacity="0" Visibility="Hidden">
                            <Grid.CacheMode>
                                <BitmapCache />
                            </Grid.CacheMode>
                            <Border CornerRadius="31" Background="{DynamicResource AccentGradientBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="28" ShadowDepth="0" Opacity="0.85" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <Border x:Name="Frame" CornerRadius="31" Background="{DynamicResource SurfaceHighBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="Glyph" Text="{Binding (ui:Fx.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           Style="{StaticResource IconText}" FontSize="20" Margin="0,0,12,0" Foreground="{TemplateBinding BorderBrush}" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SubtleTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#F5F7FA" />
                            <Setter TargetName="Frame" Property="TextElement.Foreground" Value="#0A0B10" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="#0A0B10" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Full-width row: open windows, menus, settings. Content comes from the DataTemplate. -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="MinHeight" Value="76" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ui:Fx.Mode" Value="Row" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Frame" CornerRadius="{DynamicResource ButtonRadius}" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <!-- Accent bar on the left edge of the focused row -->
                        <Border x:Name="Bar" Width="5" HorizontalAlignment="Left" Margin="0,16" CornerRadius="3"
                                Background="{DynamicResource AccentGradientBrush}" Visibility="Hidden" />
                        <Border x:Name="Ring" CornerRadius="{DynamicResource ButtonRadius}" BorderThickness="2" BorderBrush="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceHighBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#E6FFFFFF" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One cell of the colour table (custom colour picker). Background = the colour. -->
    <Style x:Key="ColorCell" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ui:Fx.Mode" Value="Cell" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#26FFFFFF" BorderThickness="1" />
                        <Border x:Name="Ring" CornerRadius="10" BorderThickness="3" BorderBrush="Transparent" Margin="-3" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
